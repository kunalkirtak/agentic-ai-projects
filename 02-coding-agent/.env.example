# Copy this file to .env for local (non-Colab) experimentation only.
# In Google Colab, DO NOT use a .env file — load the key from
# Colab Secrets instead (see README.md, "Gemini API Setup").

GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides:
GEMINI_MODEL=gemini-2.0-flash
MAX_ITERATIONS=4
EXECUTION_TIMEOUT=10
